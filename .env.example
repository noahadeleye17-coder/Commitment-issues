# GitHub OAuth App credentials
# Create one at https://github.com/settings/applications/new
# Homepage URL: your deployed URL (e.g. https://commitment-issues.vercel.app)
# Authorization callback URL: <your deployed URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The full public URL this app is deployed at (no trailing slash)
# Use http://localhost:3000 for local dev
NEXT_PUBLIC_APP_URL=http://localhost:3000
